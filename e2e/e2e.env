# Entorno aislado para la suite E2E (T18/NFR-02). Uso local:
#   docker compose -p protube-e2e --env-file e2e/e2e.env up -d --wait
#   docker compose -p protube-e2e --env-file e2e/e2e.env down -v
#
# Solo valores de prueba, sin secretos reales (mismo criterio ya aplicado a
# frontend/.env.development, frontend/.env.production y a los defaults de
# compose.yaml, que también se versionan). El job de CI no depende de este
# archivo: declara estos mismos valores directamente en el step que levanta
# Compose, así que esta copia es solo una comodidad para ejecutar la suite en
# local. Nombrado `e2e.env` (no `*.env.e2e` ni `.env`) para no confundirse con
# un archivo de entorno real de despliegue.
#
# Puertos de host distintos a los de desarrollo (8080/5432) para poder convivir
# con una instancia de desarrollo corriendo en la misma máquina.
PROTUBE_HTTP_PORT=18080
ENV_PROTUBE_DB_PORT=15432

# Nombres distintos solo para que docker ps / docker volume ls sean inequívocos
# al depurar; el aislamiento real ya lo da el nombre de proyecto `-p protube-e2e`.
ENV_PROTUBE_DB_USER=protube_e2e
ENV_PROTUBE_DB_PASS=e2e_test_only
ENV_PROTUBE_DB=protube_e2e

ENV_PROTUBE_SESSION_SECURE=false
ENV_PROTUBE_WEB_ORIGINS=http://localhost:18080

# Requeridos por compose.yaml para que arranque --pro_tube.load_initial_data=true;
# ningún test de esta suite inicia sesión como esta cuenta.
ENV_PROTUBE_DEMO_ADMIN_EMAIL=admin@protube.local
ENV_PROTUBE_DEMO_ADMIN_ACCOUNT=admin
ENV_PROTUBE_DEMO_ADMIN_PASSWORD=admin1234
